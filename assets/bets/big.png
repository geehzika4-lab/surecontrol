ias de jogo.\",\"REQUIRED\":\"O nome público é obrigatório\",\"SYMBOLS_NOT_ALLOWED\":\"O nome público pode conter letras (a-z) e dígitos (0-9)\"},\"MOBILE_PHONE\":{\"LABEL\":\"Número de celular\",\"LENGTH_INVALID\":\"Número de celular deve ter de 6 a 23 dígitos\",\"REQUIRED\":\"Número de celular é obrigatório\"},\"PHONE_CODE\":{\"LABEL\":\"Código\"},\"PHONE_CODE_EDIT\":{\"EMPTY_SUBTITLE\":\"Não conseguimos encontrar nenhum resultado para a sua busca\",\"EMPTY_TITLE\":\"Nenhum resultado encontrado\",\"PLACEHOLDER\":\"Procurar por código/país\",\"TITLE\":\"Selecionar código\"},\"SUBMIT\":{\"LABEL\":\"Atualizar Informações Pessoais\"},\"USERNAME\":{\"COPIED\":\"Copiado\",\"COPY\":\"Copiar nome de usuário\",\"LABEL\":\"Username\"}},\"MODAL_NON_EDITABLE_FIELD\":{\"CANCEL_BUTTON_TEXT\":\"Contatar suporte\",\"DESCRIPTION\":\"Contatar suporte para informações adicionais\",\"TITLE\":\"Você não pode editar este campo\"},\"MODAL_UNSAVED_CHANGES\":{\"CANCEL_BUTTON_TEXT\":\"Descartar e fechar\",\"CONFIRM_BUTTON_TEXT\":\"Salvar alterações\",\"DESCRIPTION\":\"Você está certo de que deseja retornar?\",\"TITLE\":\"Você tem mudanças que não foram salvas\"},\"NO_MODE_MESSAGE\":\"Selecione o modo de detalhes da conta.\",\"PASSWORD\":\"Senha\",\"PASSWORD_FORM\":{\"CONFIRM_NEW_PASSWORD\":{\"LABEL\":\"Confirme a nova senha\",\"VALIDATION\":{\"NOT_VALID\":\"As senhas devem ser iguais\",\"NOT_VALID_PIN\":\"PIN deve ser igual\"}},\"CURRENT_PASSWORD\":{\"LABEL\":\"Senha Atual\",\"VALIDATION\":{\"REQUIRED\":\"A senha atual deve ser digitada\",\"REQUIRED_PIN\":\"O PIN atual deve ser inserido\"}},\"ERROR_MESSAGE\":\"Não foi possível atualizar sua senha. Entre em contato com o administrador\",\"NEW_PASSWORD\":{\"LABEL\":\"Nova Senha\",\"VALIDATION\":{\"NOT_OLD_PASSWORD\":\"A nova senha não deve ser igual à senha antiga\",\"NOT_OLD_PIN\":\"Novo PIN não deve ser o mesmo que um PIN antigo\",\"NOT_USERNAME\":\"A nova senha não deve ser igual ao nome de usuário\",\"NOT_USERNAME_PIN\":\"Novo PIN não de