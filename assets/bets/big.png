me\":\"sport_backoffice_migrate_pages_to_sports_prefix\",\"status\":true},{\"name\":\"web-frontoffice-homepage-v-2-web-7947\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_rely_on_market_id_fk\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_content_card_generation_enabled\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_lite_sport_event_changes_enabled\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_extended_early_payout_enabled\",\"status\":true},{\"name\":\"sport_sportsbook_service_settlement_generics_from_esport\",\"status\":true},{\"name\":\"payment_backoffice_epay_5036\",\"status\":true},{\"name\":\"casino_frontoffice_live_casino_card_redesign\",\"status\":true},{\"name\":\"otpl-backoffice-money-transactions-with-dwh-api-table-10529\",\"status\":false},{\"name\":\"sport_sportsbook_provider_service_money_line_content_cards_early_payout_specifying_enabled\",\"status\":true},{\"name\":\"leaderboard_backoffice_winning_multiplier\",\"status\":true},{\"name\":\"sport_sportsbook_hub_service_enable_multiple_bets\",\"status\":false},{\"name\":\"engagement_promo_service_otpl_8381_promotions_ordering\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_content_card_deletion_enabled\",\"status\":true},{\"name\":\"sport_sportsbook_provider_service_decimal_hit_or_miss_and_big_hitters_events_enabled\",\"status\":false},{\"name\":\"sport-sportsbook-provider-introduce-purchase-id-enablement-os-12006\",\"status\":false},{\"name\":\"core_player_service_permissions_update\",\"status\":true}]}"])</script><script>self.__next_f.push([1,"38:T4b3,O programa de fidelidade Level-Up da 10bet distribui pontos, tornando cada lance ainda mais emocionante para quem gosta de apostar!\n\nToda vez que joga você recebe algo em troca. Cada aposta vale pontos que se acumulam e podem ser usados para comprar recompensas no marketplace.\n\nConte com a calculadora abaixo para ver quantos pontos você pode ganhar por rodada ou aposta esportiva. Use seus pontos acumulados para garantir grandes recompensas em nosso mercado 10bet.\n\nVocê pode resgatar seus pontos por rodadas grátis, apostas grátis esportivas, bônus e muito mais.\n\nAs recompensas nos níveis 1-9 são rodadas grátis e bônus. No nível 10VIP, você poderá gastar seus pontos em tecnologias e viagens. Nossa ampla variedade de recompensas ajuda a oferecer sempre algo para todos os gostos.\n\nConforme os pontos de fidelidade se acumulam, você sobe de nível. Nessa evolução, é possível desbloquear caixas misteriosas e resgatar recompensas. Cada caixa misteriosa tem um cronômetro de contagem regressiva. Quando a contagem chegar a zero, você poderá reivindicar o prêmio. Há ainda a opção de gastar seus pontos de fidelidade para abrir a caixa misteriosa imediatamente, se preferir.39:T42d,O 10CRIC sempre oferece mais e agora ficou ainda melhor! Bem-vindo ao 10CRIC Loyalty Club, o lugar onde você receberá recompensas fantásticas apenas por jogar seus jogos de cassino favoritos, ou apostar nos melhores esportes do mundo! Quer saber como? Com cada rodada ou aposta que fizer, você ganhará uma certa quantidade de pontos. E, de acordo com os pontos que somar, você se tornará membro de um dos cinco fantásticos níveis de fidelidade!\n\nQuanto mais você jogar ou apostar, mais pontos você receberá e maiores serão seus prêmios (verifique a calculadora abaixo para descobrir quantos pontos você pode ganhar por uma rodada ou aposta)! Quando tiver pontos suficientes, você poderá trocá-los por ótimas recompensas no mercado. Por falar em prêmios, cada nível de fidelidade tem caixas misteriosas, que também incluem ótimas recompensas. À medida que sobe de nível, surpresas cada vez mais espetaculares esperam por você!\n\nLembre-se de que, para manter seu nível atual, é preciso continuar jogando — simples assim. Então, vamos jogar!3b:[[\"pt\",{\"imageUrlDesktop\":\"/media/uploads/cms/BIGBET/home/218df216-abf8-4bc1-a520-6087a0a35342.svg\",\"imageUrlMobile\":\"/media/uploads/cms/BIGBET/home/ed7b61a5-a3e6-4be3-a7cf-eaa45bbaa546.svg\",\"imageUrlSiteLoaderAnimated\":\"\",\"imageUrlCasinoHeader\":\"\",\"imageUrlCasinoSplashAnimated\":\"\"}]]\n3a:[[\"BRAND_CONFIG_KEY_SITE_LOGO_DATA\",\"$Q3b\"]]\n"])</script><script>self.__next_f.push([1,"7:[\"$\",\"$L36\",null,{\"lang\":\"pt\",\"initialApolloState\":\"$37\",\"messages\":{\"ACCOUNT_DETAILS\":{\"HANDLE_FORMAT\":\"O nome público deve ter de 3 a 20 caracteres e pode conter letras (a-z) ou dígitos (0-9).\",\"HANDLE_SUBTITLE\":\"Seu identificador exclusivo dentro da comunidade.\",\"PHONE_CODE_EDIT\":{\"EMPTY_SUBTITLE\":\"Não encontramos nenhum resultado para a sua busca\",\"EMPTY_TITLE\":\"Resultados não encontrados\",\"PLACEHOLDER\":\"Procurar por código/país\",\"TITLE\":\"Selecionar código\"},\"PHONE_NUMBER_EDIT\":{\"TITLE\":\"Número de telefone\"},\"SAVE\":\"Candidatar-se\"},\"AVAILABLE_BONUSES\":\"Bônus disponíveis\",\"BALANCE\":\"Saldo\",\"CAPTCHA_REQUIRED\":\"Captcha necessário\",\"CARD\":{\"COLLECT_REWARD\":\"Coletar\",\"NEW_TO_LOYALTY_DESCRIPTION\":\"Saiba mais sobre como ganhar Joias.\",\"NEW_TO_LOYALTY_DESCRIPTION_10BETCOM\":\"Calculadora de pontos de fidelidade\",\"NEW_TO_LOYALTY_DESCRIPTION_10BETZA\":\"Saiba mais sobre como ganhar pontos de fidelidade.\",\"NEW_TO_LOYALTY_DESCRIPTION_10CRIC\":\"Saiba mais sobre como ganhar Moedas.\",\"NEW_TO_LOYALTY_TITLE\":\"Programa de Fidelidade\",\"NEW_TO_LOYALTY_TITLE_10BETZA\":\"Suba de nível agora\",\"NEW_TO_LOYALTY_TITLE_10CRIC\":\"Clube de fidelidade\",\"YOU_HAVE_UNLOCKED\":\"Você desbloqueou\"},\"COLLECT_MISSION_REWARD\":\"Coletar\",\"COMMUNITY_CHAT\":{\"CLOSE_CHAT\":\"Fechar Chat\",\"LABEL\":\"Chat\",\"UNAUTHORIZED_HELPER_TEXT\":\"Por favor, faça login para participar do chat\"},\"DEPOSIT\":\"Depositar\",\"DEPOSIT_PROMPT\":\"Deposite e aproveite os pontos\",\"DEPOSIT_PROMPT_10BETCOM\":\"Deposite e ganhe pontos!\",\"DEPOSIT_PROMPT_10BETZA\":\"Deposite agora\",\"DEPOSIT_PROMPT_10CRIC\":\"Deposite e aproveite os pontos\",\"ENDS\":\